{
  "name": "Places API",
  "endpoints": [
    {
      "id": "signup",
      "method": "POST",
      "path": "/api/signup",
      "title": "Регистрация пользователя",
      "auth": false,
      "fields": [
        {
          "field": "email",
          "type": "string",
          "required": true,
          "rule": "5–50 символов (вся строка); английские буквы, цифры, «-», «.», «@»"
        },
        {
          "field": "password",
          "type": "string",
          "required": true,
          "rule": "8–20 символов; минимум: заглавная, строчная, цифра, спецсимвол"
        }
      ],
      "success": {
        "status": 201,
        "body": "data: _id, email, name, about, avatar"
      },
      "errors": [
        [
          400,
          "Не передан обязательный параметр"
        ],
        [
          400,
          "Почта введена некорректно"
        ],
        [
          400,
          "Пароль введен некорректно"
        ],
        [
          409,
          "Пользователь с таким email уже существует"
        ],
        [
          500,
          "Внутренняя ошибка сервера"
        ]
      ]
    },
    {
      "id": "signin",
      "method": "POST",
      "path": "/api/signin",
      "title": "Авторизация пользователя",
      "auth": false,
      "fields": [
        {
          "field": "email",
          "type": "string",
          "required": true,
          "rule": "почта, указанная при регистрации"
        },
        {
          "field": "password",
          "type": "string",
          "required": true,
          "rule": "пароль пользователя"
        }
      ],
      "success": {
        "status": 200,
        "body": "data: _id, email, name, about, avatar; token (JWT)"
      },
      "errors": [
        [
          400,
          "Не передан обязательный параметр"
        ],
        [
          400,
          "Почта введена некорректно"
        ],
        [
          401,
          "Неправильные почта или пароль"
        ],
        [
          404,
          "Пользователь не найден"
        ]
      ]
    },
    {
      "id": "cards",
      "method": "POST",
      "path": "/api/cards",
      "title": "Добавление карточки места",
      "auth": true,
      "fields": [
        {
          "field": "name",
          "type": "string",
          "required": true,
          "rule": "2–30 символов"
        },
        {
          "field": "link",
          "type": "string",
          "required": true,
          "rule": "валидный URL изображения"
        }
      ],
      "success": {
        "status": 201,
        "body": "data: _id, name, link, owner, likes[], createdAt"
      },
      "errors": [
        [
          400,
          "Отсутствует наименование"
        ],
        [
          400,
          "Отсутствует ссылка на изображение"
        ],
        [
          400,
          "Наименование введено некорректно"
        ],
        [
          400,
          "Ссылка введена некорректно"
        ],
        [
          401,
          "Требуется авторизация"
        ]
      ]
    }
  ],
