  "gray_zones": [
    {
      "id": "GZ-P1",
      "topic": "Длина email",
      "problem": "В документации длина считается для всей строки (5–50). В примерах из материалов считалась длина части до «@».",
      "question": "Что именно ограничено: вся строка или часть до «@»?",
      "assumption": "Принято: вся строка. Границы строятся по общей длине."
    },
    {
      "id": "GZ-P2",
      "topic": "Пустое значение или отсутствие поля",
      "problem": "Сообщение для пустой строки в email, password, name не определено: «Не передан обязательный параметр» или «…некорректно».",
      "question": "Одинаково ли обрабатываются пустая строка и отсутствие поля?",
      "assumption": "Проверяется только код ответа (400)."
    },
    {
      "id": "GZ-P3",
      "topic": "Вход: некорректный формат email",
      "problem": "Документация даёт 400 «Почта введена некорректно», а в одном из вариантов таблицы принят 401.",
      "question": "Проверяется ли формат email при входе?",
      "assumption": "Принято по документации: 400."
    },
    {
      "id": "GZ-P4",
      "topic": "Вход: несуществующий пользователь",
      "problem": "Один вариант таблицы даёт 404 для любых данных, другой смешивает 401 и 404.",
      "question": "Какой код при несуществующем пользователе и неверном пароле?",
      "assumption": "Принято: 404 для корректных данных."
    },
    {
      "id": "GZ-P5",
      "topic": "Допустимые спецсимволы пароля",
      "problem": "Дан пример «!@#$%^&*()», полный список не определён; кириллица не описана.",
      "question": "Какие символы допустимы?",
      "assumption": "Кириллица считается недопустимой."
    },
    {
      "id": "GZ-P6",
      "topic": "Пробелы в названии места",
      "problem": "Пробел до или после названия: обрезается ли, входит ли в длину?",
      "question": "Применяется ли trim?",
      "assumption": "Проверка не включена в чек-лист."
    },
    {
      "id": "GZ-P7",
      "topic": "Формат ссылки",
      "problem": "Не определены допустимые схемы (http, ftp), проверка доступности изображения.",
      "question": "Что считается валидным URL?",
      "assumption": "Проверяется формат «https://…»."
    },
    {
      "id": "GZ-P8",
      "topic": "Токен",
      "problem": "Не указаны срок жизни и формат заголовка (с префиксом Bearer или без).",
      "question": "Как передавать токен?",
      "assumption": "Заголовок Authorization со значением токена."
    },
    {
      "id": "GZ-P9",
      "topic": "Ошибка 500 при регистрации",
      "problem": "Внутренняя ошибка описана в документации, условия её воспроизведения не указаны.",
      "question": "Когда возвращается 500?",
      "assumption": "Не проверяется."
    },
    {
      "id": "GZ-P10",
      "topic": "Регистр email",
      "problem": "Считаются ли «A@example.com» и «a@example.com» одним пользователем?",
      "question": "Нужна ли нормализация?",
      "assumption": "Не проверяется."
    },
    {
      "id": "GZ-P11",
      "topic": "Создание записи в БД",
      "problem": "Проверить сохранение пользователя в базе нельзя: нет доступа к БД и нет метода чтения.",
      "question": "Есть ли метод получения пользователя?",
      "assumption": "Пропущено (Skipped)."
    }
  ],
